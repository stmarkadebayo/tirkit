{
  "name": "tirkit-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "api": "node scripts/gen-api.mjs",
    "api:check": "node scripts/gen-api.mjs && git diff --exit-code -- src/api/schema.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.9"
  }
}
