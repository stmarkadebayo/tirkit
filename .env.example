# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, a local Ollama at http://localhost:11434/v1...)
LLM_BASE_URL=
LLM_API_KEY=
# Model the demo app calls; the judge uses JUDGE_MODEL.
LLM_MODEL=
JUDGE_MODEL=
# Hard cap on judge spend per process, in USD (empty = no cap).
JUDGE_BUDGET_USD=5
# For the Anthropic judge (AnthropicJudge); the SDK also reads `ant auth login` profiles.
ANTHROPIC_API_KEY=
TIRKIT_DB_PATH=tirkit.db
# Server mode for the SDK (M4): send traces to a Tirkit server instead of a local file.
TIRKIT_HOST=
TIRKIT_PUBLIC_KEY=
TIRKIT_SECRET_KEY=
