# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, a local Ollama at http://localhost:11434/v1...)
LLM_BASE_URL=
LLM_API_KEY=
# Model the demo app calls; the judge uses JUDGE_MODEL.
LLM_MODEL=
JUDGE_MODEL=
# Hard cap on judge spend per process, in USD (empty = no cap).
JUDGE_BUDGET_USD=5
# For the Anthropic judge (AnthropicJudge); the SDK also reads `ant auth login` profiles.
ANTHROPIC_API_KEY=
TIRKIT_DB_PATH=tirkit.db
# Server mode for the SDK (M4): send traces to a Tirkit server instead of a local file.
TIRKIT_HOST=
TIRKIT_PUBLIC_KEY=
TIRKIT_SECRET_KEY=

# Security (docs/site/security.md). Behind a reverse proxy, the number of proxies that append to X-Forwarded-For.
TIRKIT_TRUSTED_PROXIES=0
# Browser origins allowed to send traces directly (comma-separated); empty = same-origin only.
TIRKIT_CORS_ORIGINS=
# Spans per second per API key (0 = no limit) and its burst; empty burst = 10 seconds' worth.
TIRKIT_INGEST_SPANS_PER_S=5000
TIRKIT_INGEST_BURST=
# 1 lets alert webhooks target private addresses (a chat server on your own network).
TIRKIT_ALLOW_PRIVATE_WEBHOOKS=
# SDK-side PII redaction: off, secrets or strict (empty = the server's project setting only).
TIRKIT_REDACT=
